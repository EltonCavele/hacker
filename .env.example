BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app
# Max pg connections per process (default 10). Behind PgBouncer, point DATABASE_URL at the pooler.
DATABASE_POOL_MAX=
REDIS_URL=redis://localhost:6379
# resend | log (log prints emails to the server console)
EMAIL_PROVIDER=resend
EMAIL_FROM=Next.js Starter <onboarding@resend.dev>
RESEND_API_KEY=""

# Optional OAuth provider. Configure the callback URL as:
# http://localhost:3000/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# whatsapp | log (log prints messages to the server console; no webhooks)
MESSAGING_PROVIDER=whatsapp
# Direct Meta WhatsApp Cloud API credentials (no Kapso proxy)
META_ACCESS_TOKEN=
META_APP_SECRET=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# S3-compatible object storage (MinIO, Amazon S3, Railway Bucket, etc.)
STORAGE_PROVIDER=s3
STORAGE_BUCKET=app
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_SESSION_TOKEN=
STORAGE_FORCE_PATH_STYLE=true
STORAGE_MAX_UPLOAD_BYTES=26214400
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_CORS_ALLOW_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Payments (webhooks: /api/payments/epay/webhook and /api/payments/dodo/webhook)
PAYMENT_CATALOG=[]
EPAY_BASE_URL=https://checkout.epay.co.mz/api/v1
EPAY_SECRET_KEY=
EPAY_SIGNATURE_HEADER=x-educavelpay-signature
EPAY_WEBHOOK_URL=http://localhost:3000/api/payments/epay/webhook
EPAY_REQUEST_TIMEOUT_MS=15000
EPAY_RECONCILIATION_TOKEN=
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode

# Web Push (generate with: npx web-push generate-vapid-keys). Optional: without them pushes are skipped.
VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Observability. Without a DSN, Sentry is disabled and errors only go to the structured logs.
# LOG_LEVEL: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
SENTRY_DSN=
# Browser SDK. Inlined at build time: pass it as a build arg (Docker) or set it before `npm run build`.
NEXT_PUBLIC_SENTRY_DSN=

# How many reverse proxies sit in front of the app (Railway, Vercel, nginx = 1). Used to read the client IP for
# rate limiting; set 0 when the app is exposed directly so X-Forwarded-For is ignored.
TRUSTED_PROXY_HOPS=1

# Language auto-detection for first-time visitors (see docs/i18n.md). A CDN country header (Cloudflare, Vercel) is used
# first; otherwise the IP is looked up once at {ip} (plain-text ISO country code) and the result is kept in a cookie.
# GEOIP_URL=https://ipapi.co/{ip}/country/

# Port of the worker's health endpoint (GET /health).
WORKER_HEALTH_PORT=3100

# Shown on /terms and /privacy (replace the placeholders before going live)
LEGAL_COMPANY_NAME=
LEGAL_CONTACT_EMAIL=
