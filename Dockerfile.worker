# Same image as the `worker` stage of Dockerfile, for platforms that cannot select a build target.
ARG NODE_IMAGE=node:22-bookworm-slim

FROM ${NODE_IMAGE}
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
# Placeholders so `prisma generate` can load prisma.config.ts; real values are provided at runtime.
ENV DATABASE_URL=postgresql://postgres:postgres@postgres:5432/app
RUN apt-get update && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund --fetch-retries=1 --fetch-timeout=120000
COPY . .
RUN npm run db:generate
USER node
EXPOSE 3100
HEALTHCHECK --interval=15s --timeout=5s --start-period=15s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.WORKER_HEALTH_PORT||3100)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["npm", "run", "worker"]
