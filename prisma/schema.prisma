generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  passkeyPromptedAt DateTime?
  onboardedAt   DateTime?
  accounts      Account[]
  passkeys      Passkey[]
  pushSubscriptions PushSubscription[]
  tasks         Task[]
  sentMessages  Message[]
  paymentPurchases PaymentPurchase[]
  paymentSubscriptions PaymentSubscription[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime? @default(now())
  aaguid       String?

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

model PushSubscription {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  revokedAt  DateTime?
  lastSeenAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId, revokedAt])
  @@map("push_subscription")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Task {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String
  title     String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt])
  @@map("tasks")
}

model Conversation {
  id                    String    @id @default(uuid()) @db.Uuid
  channel               String
  channelAccountId      String
  externalContactId     String
  lastMessageAt         DateTime? @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(6)
  messages              Message[]

  @@unique([channel, channelAccountId, externalContactId])
  @@index([channel, lastMessageAt])
  @@map("conversations")
}

model Message {
  id                String       @id @default(uuid()) @db.Uuid
  channel           String
  externalId        String
  direction         String
  contentType       String
  text              String?
  payload           Json?
  status            String
  statusUpdatedAt   DateTime?    @db.Timestamptz(6)
  failureReason     String?
  occurredAt        DateTime     @db.Timestamptz(6)
  createdAt         DateTime     @default(now()) @db.Timestamptz(6)
  conversationId    String       @db.Uuid
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sentByUserId      String?
  sentByUser        User?        @relation(fields: [sentByUserId], references: [id], onDelete: SetNull)

  @@unique([channel, externalId])
  @@index([conversationId, occurredAt])
  @@index([sentByUserId])
  @@map("messages")
}

enum PaymentProvider {
  EPAY
  DODO
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentSubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  ON_HOLD
  EXPIRED
}

model PaymentPurchase {
  id                   String         @id @default(uuid()) @db.Uuid
  userId               String
  productId            String         @map("product_id")
  provider             PaymentProvider
  status               PaymentStatus  @default(PENDING)
  currency             String         @db.VarChar(3)
  amountMinor          Int            @map("amount_minor")
  providerCheckoutId   String?        @unique @map("provider_checkout_id")
  providerPaymentId    String?        @unique @map("provider_payment_id")
  providerSubscriptionId String?      @map("provider_subscription_id")
  checkoutUrl          String?        @map("checkout_url")
  expiresAt            DateTime?      @map("expires_at") @db.Timestamptz(6)
  paidAt               DateTime?      @map("paid_at") @db.Timestamptz(6)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([provider, status, createdAt])
  @@map("payment_purchases")
}

model PaymentProviderEvent {
  id          String         @id @default(uuid()) @db.Uuid
  provider    PaymentProvider
  eventId     String         @unique @map("event_id")
  eventType   String         @map("event_type")
  processedAt DateTime       @default(now()) @map("processed_at") @db.Timestamptz(6)
  metadata    Json?

  @@map("payment_provider_events")
}

model PaymentSubscription {
  id                     String                     @id @default(uuid()) @db.Uuid
  userId                 String                     @map("user_id")
  productId              String                     @map("product_id")
  provider               PaymentProvider
  providerSubscriptionId String                     @unique @map("provider_subscription_id")
  providerCustomerId     String?                    @map("provider_customer_id")
  status                 PaymentSubscriptionStatus  @default(ACTIVE)
  currency               String                     @db.VarChar(3)
  amountMinor            Int                        @map("amount_minor")
  currentPeriodStart     DateTime?                  @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd       DateTime?                  @map("current_period_end") @db.Timestamptz(6)
  cancelAtPeriodEnd      Boolean                    @default(false) @map("cancel_at_period_end")
  createdAt              DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                   User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("payment_subscriptions")
}

// Transactional outbox: written in the same transaction as the business change, then relayed to BullMQ by the worker.
model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  queue       String
  name        String
  payload     Json
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")
  availableAt DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)

  @@index([processedAt, availableAt])
  @@map("outbox_events")
}

enum FolhaSector {
  EDUCATION
  HEALTH
  DISTRICT_ADMIN
  POLICE
  CENTRAL
}

enum FolhaEmployeeStatus {
  ACTIVE
  IN_TRANSIT
  DISPLACED
  ON_LEAVE
  LEFT
  DECEASED
  NO_UNIT
  ADMISSION_PENDING
}

enum FolhaAttestationMark {
  PRESENT
  ABSENT_JUSTIFIED
  ON_LEAVE
  TRANSFERRED
  LEFT
  DECEASED
  UNKNOWN
}

enum FolhaAnomalyType {
  SHARED_ACCOUNT
  ACCOUNT_HOLDER_MISMATCH
  DUPLICATE_FACE
  DUPLICATE_NUIT
  DUPLICATE_ID
  SALARY_AND_PENSION
  OVER_RETIREMENT_AGE
  NO_UNIT
  NO_CHIEF
  GROWTH_WITHOUT_ADMISSION
  UNUSUAL_OPERATOR
}

enum FolhaRisk {
  HIGH
  MEDIUM
}

enum FolhaDrawPhotoResult {
  MATCH
  NO_SHOW
  LOCATION_FAIL
  NOT_A_LIVE_FACE
}

enum FolhaMovementType {
  ADMISSION
  TRANSFER
  RETIREMENT
  DEATH
  ABANDONMENT
}

enum FolhaContestStatus {
  OPEN
  VERIFIED_GENUINE
  VERIFIED_GHOST
}

enum FolhaCaseType {
  DISCIPLINARY
  VOLUNTARY_RETURN
}

enum FolhaCaseStatus {
  OPEN
  CLOSED
}

model FolhaCycle {
  id        String   @id @default(uuid()) @db.Uuid
  yearMonth String   @unique @map("year_month")
  opensAt   DateTime @map("opens_at") @db.Timestamptz(6)
  closesAt  DateTime @map("closes_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  attestations FolhaAttestation[]
  anomalies    FolhaAnomaly[]
  draws        FolhaDraw[]
  audits       FolhaAudit[]
  contests     FolhaContest[]

  @@map("folha_cycles")
}

model FolhaUnit {
  id               String      @id @default(uuid()) @db.Uuid
  name             String
  type             String
  sector           FolhaSector
  district         String
  province         String
  ugb              String
  parentId         String?     @map("parent_id") @db.Uuid
  parent           FolhaUnit?  @relation("FolhaUnitTree", fields: [parentId], references: [id], onDelete: SetNull)
  children         FolhaUnit[] @relation("FolhaUnitTree")
  chiefEmployeeId  String?     @unique @map("chief_employee_id") @db.Uuid
  chief            FolhaEmployee? @relation("FolhaUnitChief", fields: [chiefEmployeeId], references: [id], onDelete: SetNull)
  deputyEmployeeId String?     @map("deputy_employee_id") @db.Uuid
  deputy           FolhaEmployee? @relation("FolhaUnitDeputy", fields: [deputyEmployeeId], references: [id], onDelete: SetNull)
  offlineZone      Boolean     @default(false) @map("offline_zone")
  conflictZone     Boolean     @default(false) @map("conflict_zone")
  deviceWiped      Boolean     @default(false) @map("device_wiped")
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  employees     FolhaEmployee[] @relation("FolhaEmployeeUnit")
  attestations  FolhaAttestation[]
  anomalies     FolhaAnomaly[]
  draws         FolhaDraw[]
  audits        FolhaAudit[]
  fromMovements FolhaMovement[] @relation("FolhaMovementFrom")
  toMovements   FolhaMovement[] @relation("FolhaMovementTo")

  @@index([district])
  @@map("folha_units")
}

model FolhaEmployee {
  id                String              @id @default(uuid()) @db.Uuid
  name              String
  nuit              String
  identityCard      String              @map("identity_card")
  bornAt            DateTime            @map("born_at") @db.Date
  faceToken         String              @map("face_token")
  accountNumber     String              @map("account_number")
  accountHolder     String              @map("account_holder")
  salaryMzn         Int                 @map("salary_mzn")
  status            FolhaEmployeeStatus @default(ACTIVE)
  receivesPension   Boolean             @default(false) @map("receives_pension")
  operatorId        String              @map("operator_id")
  createdWithoutProcess Boolean         @default(false) @map("created_without_process")
  unitId            String?             @map("unit_id") @db.Uuid
  unit              FolhaUnit?          @relation("FolhaEmployeeUnit", fields: [unitId], references: [id], onDelete: SetNull)
  transitStartedAt  DateTime?           @map("transit_started_at") @db.Timestamptz(6)
  leaveEndsAt       DateTime?           @map("leave_ends_at") @db.Timestamptz(6)
  unclaimedSince    DateTime?           @map("unclaimed_since") @db.Timestamptz(6)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  headedUnits  FolhaUnit[] @relation("FolhaUnitChief")
  deputyUnits  FolhaUnit[] @relation("FolhaUnitDeputy")
  attestations FolhaAttestation[]
  anomalies    FolhaAnomaly[]
  draws        FolhaDraw[]
  audits       FolhaAudit[]
  movements    FolhaMovement[]
  contests     FolhaContest[]
  cases        FolhaCase[]

  @@index([nuit])
  @@index([identityCard])
  @@index([faceToken])
  @@index([accountNumber])
  @@index([unitId])
  @@map("folha_employees")
}

model FolhaAttestation {
  id             String               @id @default(uuid()) @db.Uuid
  cycleId        String               @map("cycle_id") @db.Uuid
  cycle          FolhaCycle           @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  unitId         String               @map("unit_id") @db.Uuid
  unit           FolhaUnit            @relation(fields: [unitId], references: [id], onDelete: Cascade)
  employeeId     String               @map("employee_id") @db.Uuid
  employee       FolhaEmployee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  mark           FolhaAttestationMark
  justification  String?
  createdOffline Boolean              @default(false) @map("created_offline")
  synced         Boolean              @default(true)
  warnedAt       DateTime?            @map("warned_at") @db.Timestamptz(6)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([cycleId, employeeId])
  @@index([unitId, cycleId])
  @@map("folha_attestations")
}

model FolhaAnomaly {
  id         String           @id @default(uuid()) @db.Uuid
  cycleId    String           @map("cycle_id") @db.Uuid
  cycle      FolhaCycle       @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  type       FolhaAnomalyType
  risk       FolhaRisk
  employeeId String?          @map("employee_id") @db.Uuid
  employee   FolhaEmployee?   @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  unitId     String?          @map("unit_id") @db.Uuid
  unit       FolhaUnit?       @relation(fields: [unitId], references: [id], onDelete: SetNull)
  detail     String
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([cycleId, risk])
  @@map("folha_anomalies")
}

model FolhaDraw {
  id          String                 @id @default(uuid()) @db.Uuid
  cycleId     String                 @map("cycle_id") @db.Uuid
  cycle       FolhaCycle             @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  unitId      String                 @map("unit_id") @db.Uuid
  unit        FolhaUnit              @relation(fields: [unitId], references: [id], onDelete: Cascade)
  employeeId  String                 @map("employee_id") @db.Uuid
  employee    FolhaEmployee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  photoResult FolhaDrawPhotoResult?
  completedAt DateTime?              @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([cycleId, employeeId])
  @@index([unitId, cycleId])
  @@map("folha_draws")
}

model FolhaAudit {
  id         String                @id @default(uuid()) @db.Uuid
  cycleId    String                @map("cycle_id") @db.Uuid
  cycle      FolhaCycle            @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  unitId     String                @map("unit_id") @db.Uuid
  unit       FolhaUnit             @relation(fields: [unitId], references: [id], onDelete: Cascade)
  employeeId String                @map("employee_id") @db.Uuid
  employee   FolhaEmployee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attestedAs FolhaAttestationMark?
  foundPresent Boolean             @map("found_present")
  visitedAt  DateTime              @default(now()) @map("visited_at") @db.Timestamptz(6)

  @@index([unitId, cycleId])
  @@map("folha_audits")
}

model FolhaMovement {
  id          String            @id @default(uuid()) @db.Uuid
  type        FolhaMovementType
  employeeId  String            @map("employee_id") @db.Uuid
  employee    FolhaEmployee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  fromUnitId  String?           @map("from_unit_id") @db.Uuid
  fromUnit    FolhaUnit?        @relation("FolhaMovementFrom", fields: [fromUnitId], references: [id], onDelete: SetNull)
  toUnitId    String?           @map("to_unit_id") @db.Uuid
  toUnit      FolhaUnit?        @relation("FolhaMovementTo", fields: [toUnitId], references: [id], onDelete: SetNull)
  createdBy   String            @map("created_by")
  acceptedBy  String?           @map("accepted_by")
  occurredAt  DateTime          @map("occurred_at") @db.Timestamptz(6)
  acceptedAt  DateTime?         @map("accepted_at") @db.Timestamptz(6)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([employeeId, occurredAt])
  @@map("folha_movements")
}

model FolhaContest {
  id            String             @id @default(uuid()) @db.Uuid
  cycleId       String             @map("cycle_id") @db.Uuid
  cycle         FolhaCycle         @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employeeId    String             @map("employee_id") @db.Uuid
  employee      FolhaEmployee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  status        FolhaContestStatus @default(OPEN)
  reason        String
  resolvedAt    DateTime?          @map("resolved_at") @db.Timestamptz(6)
  reactivatedAt DateTime?          @map("reactivated_at") @db.Timestamptz(6)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([employeeId, cycleId])
  @@map("folha_contests")
}

model FolhaCase {
  id              String          @id @default(uuid()) @db.Uuid
  type            FolhaCaseType
  status          FolhaCaseStatus @default(OPEN)
  employeeId      String          @map("employee_id") @db.Uuid
  employee        FolhaEmployee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  detail          String
  amountRecovered Int             @default(0) @map("amount_recovered")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status])
  @@map("folha_cases")
}
